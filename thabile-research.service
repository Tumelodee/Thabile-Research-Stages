[Unit]
Description=Thabile Research Stages Flask Application
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/applications/Thabile-Research-Stages
Environment="PATH=/root/applications/Thabile-Research-Stages/.venv/bin"
Environment="RESULTS_DIR=/root/applications/Thabile-Research-Stages/results"
ExecStart=/root/applications/Thabile-Research-Stages/.venv/bin/python app.py --host 0.0.0.0 --port 5011
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=thabile-research

[Install]
WantedBy=multi-user.target
